{
  "name": "fufutrading",
  "productName": "FuFu Trading",
  "version": "0.1.0",
  "description": "Fast, modular crypto trading platform (BTC, ETH, SOL) with live Binance data, paper trading, Pine Script + Python scripting, backtesting, optimization, replay and AI-assisted strategy development.",
  "main": "dist/main/index.js",
  "private": true,
  "author": "jesko7",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "start": "node scripts/build.mjs && node scripts/start.mjs",
    "app": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node scripts/build.mjs && node tests/e2e/run.mjs",
    "shortcut": "node scripts/build.mjs && node scripts/start.mjs --create-shortcut",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win",
    "dist:linux": "node scripts/build.mjs --prod && electron-builder --linux"
  },
  "dependencies": {
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "dev.jesko7.fufutrading",
    "productName": "FuFu Trading",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/pyodide/**/*"
    ],
    "asarUnpack": [
      "node_modules/pyodide/**/*",
      "dist/python/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
