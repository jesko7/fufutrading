//@version=6
// @name Williams %R
// @category Oscillators
// @description Position of the close within the high-low range (-100...0).
indicator("Williams Percent Range", shorttitle="Williams %R", format=format.price, precision=2)
length = input.int(14, "Length", minval=1)
_pr(length) =>
    hi = ta.highest(length)
    lo = ta.lowest(length)
    100 * (close - hi) / (hi - lo)
percentR = _pr(length)
obPlot = hline(-20, "Upper Band", color=#787B86)
hline(-50, "Middle Level", color=color.new(#787B86, 50))
osPlot = hline(-80, "Lower Band", color=#787B86)
fill(obPlot, osPlot, title="Background", color=color.rgb(126, 87, 194, 90))
plot(percentR, "%R", color=#7E57C2)
