//@version=6
// @name Supertrend Strategy
// @category Strategies
// @description Follows Supertrend flips (long/short or long-only).
strategy("Supertrend Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)
atrPeriod = input.int(10, "ATR length", minval=1)
factor = input.float(3.0, "Factor", minval=0.1, step=0.1)
longOnly = input.bool(true, "Long only")
[st, dir] = ta.supertrend(factor, atrPeriod)
plot(dir < 0 ? st : na, "Up", color=color.green, style=plot.style_linebr)
plot(dir > 0 ? st : na, "Down", color=color.red, style=plot.style_linebr)
if ta.change(dir) < 0
    strategy.entry("Long", strategy.long)
if ta.change(dir) > 0
    if longOnly
        strategy.close("Long")
    else
        strategy.entry("Short", strategy.short)
