//@version=6
// @name MA Crossover Strategy
// @category Strategies
// @description Long when the fast MA crosses above the slow MA, exit (or reverse short) on the opposite cross.
strategy("MA Crossover Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)
fastLen = input.int(20, "Fast length", minval=1)
slowLen = input.int(50, "Slow length", minval=2)
maType = input.string("EMA", "MA type", options=["SMA", "EMA"])
allowShort = input.bool(false, "Allow shorts")
fast = maType == "EMA" ? ta.ema(close, fastLen) : ta.sma(close, fastLen)
slow = maType == "EMA" ? ta.ema(close, slowLen) : ta.sma(close, slowLen)
plot(fast, "Fast", color=color.teal)
plot(slow, "Slow", color=color.orange)
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    if allowShort
        strategy.entry("Short", strategy.short)
    else
        strategy.close("Long")
