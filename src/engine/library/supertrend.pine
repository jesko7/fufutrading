//@version=6
// @name Supertrend
// @category Trend
// @description ATR trailing stop that flips with the trend: green below price in uptrends, red above in downtrends.
indicator("Supertrend", overlay=true)
atrPeriod = input.int(10, "ATR Length", minval=1)
factor = input.float(3.0, "Factor", minval=0.01, step=0.01)
[st, dir] = ta.supertrend(factor, atrPeriod)
st := barstate.isfirst ? na : st
up = plot(dir < 0 ? st : na, "Up Trend", color=color.green, style=plot.style_linebr)
dn = plot(dir < 0 ? na : st, "Down Trend", color=color.red, style=plot.style_linebr)
mid = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle", display=display.none)
fill(mid, up, color.new(color.green, 90))
fill(mid, dn, color.new(color.red, 90))
alertcondition(dir[1] > dir, "Downtrend to Uptrend", "Supertrend switched to uptrend")
alertcondition(dir[1] < dir, "Uptrend to Downtrend", "Supertrend switched to downtrend")
