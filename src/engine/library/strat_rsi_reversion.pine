//@version=6
// @name RSI Mean Reversion
// @category Strategies
// @description Buy when RSI drops below the oversold level, sell when it recovers above the exit level; optional trend filter.
strategy("RSI Mean Reversion", overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)
len = input.int(14, "RSI length", minval=2)
os = input.int(30, "Oversold", minval=1, maxval=50)
ex = input.int(55, "Exit level", minval=30, maxval=95)
useTrend = input.bool(true, "Only with trend (close > SMA)")
trendLen = input.int(200, "Trend SMA length", minval=2)
stopPct = input.float(5.0, "Stop loss %", minval=0.1, step=0.1)
r = ta.rsi(close, len)
trendOk = not useTrend or close > ta.sma(close, trendLen)
plot(r, "RSI", color=#7E57C2)
hline(os, "Oversold", color=color.gray)
hline(ex, "Exit", color=color.gray)
if ta.crossunder(r, os) and trendOk and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    strategy.exit("Stop", "Long", stop=strategy.position_avg_price * (1 - stopPct / 100))
if ta.crossover(r, ex)
    strategy.close("Long")
