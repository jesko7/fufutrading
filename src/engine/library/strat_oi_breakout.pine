//@version=6
// @name OI Breakout Strategy
// @category Strategies
// @description Channel breakouts confirmed by rising open interest (new positions behind the move); exits at the shorter opposite channel. Uses Binance futures statistics (since September 2020).
strategy("OI Breakout Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)
len = input.int(20, "Breakout length", minval=2)
exitLen = input.int(10, "Exit length", minval=2)
oiLen = input.int(12, "OI lookback (bars)", minval=1)
oiMin = input.float(1.0, "Min OI rise %", step=0.1)
allowShort = input.bool(false, "Allow shorts")
// BINANCE:<symbol>.P_OI: open interest of the perpetual, 5-minute samples
oi = request.security(syminfo.prefix + ":" + syminfo.ticker + "_OI", timeframe.in_seconds() < 300 ? "5" : timeframe.period, close)
oiRise = (oi / oi[oiLen] - 1) * 100
hi = ta.highest(high, len)[1]
lo = ta.lowest(low, len)[1]
exitHi = ta.highest(high, exitLen)[1]
exitLo = ta.lowest(low, exitLen)[1]
plot(hi, "Upper", color.teal)
plot(lo, "Lower", color.red)
if close > hi and oiRise >= oiMin
    strategy.entry("Long", strategy.long)
if allowShort and close < lo and oiRise >= oiMin
    strategy.entry("Short", strategy.short)
if close < exitLo
    strategy.close("Long")
if close > exitHi
    strategy.close("Short")
