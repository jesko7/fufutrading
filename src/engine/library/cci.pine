//@version=6
// @name Commodity Channel Index (CCI)
// @category Oscillators
// @description (typical price - SMA) / (0.015 x mean deviation).
indicator("Commodity Channel Index", shorttitle="CCI", format=format.price, precision=2)
length = input.int(20, "Length", minval=1)
src = input.source(hlc3, "Source")
cci = ta.cci(src, length)
plot(cci, "CCI", color=#2962FF)
b1 = hline(100, "Upper Band", color=#787B86)
hline(0, "Middle Band", color=color.new(#787B86, 50))
b0 = hline(-100, "Lower Band", color=#787B86)
fill(b1, b0, color=color.rgb(33, 150, 243, 90), title="Background")
