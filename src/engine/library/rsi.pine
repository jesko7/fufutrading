//@version=6
// @name Relative Strength Index (RSI)
// @category Oscillators
// @description Wilder's RSI (0-100) with an optional smoothing moving average and 70/30 bands.
indicator("Relative Strength Index", shorttitle="RSI", format=format.price, precision=2)
len = input.int(14, "RSI Length", minval=1)
src = input.source(close, "Source")
maType = input.string("SMA", "MA Type", options=["None", "SMA", "EMA", "WMA"])
maLen = input.int(14, "MA Length", minval=1)
upperBand = input.int(70, "Overbought", minval=50, maxval=100)
lowerBand = input.int(30, "Oversold", minval=0, maxval=50)
r = ta.rsi(src, len)
ma = switch maType
    "SMA" => ta.sma(r, maLen)
    "EMA" => ta.ema(r, maLen)
    "WMA" => ta.wma(r, maLen)
    => na
plot(r, "RSI", color=#7E57C2)
plot(ma, "RSI-based MA", color=color.yellow)
h1 = hline(upperBand, "Upper Band", color=#787B86)
hline(50, "Middle Band", color=color.new(#787B86, 50))
h0 = hline(lowerBand, "Lower Band", color=#787B86)
fill(h1, h0, color=color.rgb(126, 87, 194, 90), title="Background")
alertcondition(ta.crossover(r, upperBand), "RSI overbought", "RSI crossed above the overbought level")
alertcondition(ta.crossunder(r, lowerBand), "RSI oversold", "RSI crossed below the oversold level")
