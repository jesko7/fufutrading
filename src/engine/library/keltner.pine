//@version=6
// @name Keltner Channels
// @category Volatility
// @description EMA basis with bands at +/- k x ATR (or average high-low range).
indicator("Keltner Channels", shorttitle="KC", overlay=true)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "Multiplier")
src = input.source(close, "Source")
useAtr = input.bool(true, "Use ATR")
atrLen = input.int(10, "ATR length", minval=1)
basis = ta.ema(src, length)
rangema = useAtr ? ta.atr(atrLen) : ta.ema(high - low, length)
upper = basis + rangema * mult
lower = basis - rangema * mult
u = plot(upper, "Upper", color=#2962FF)
plot(basis, "Basis", color=#2962FF)
l = plot(lower, "Lower", color=#2962FF)
fill(u, l, color=color.rgb(33, 150, 243, 95), title="Background")
