//@version=6
// @name Donchian Breakout (Turtle)
// @category Strategies
// @description Buy stop above the N-bar high, exit below the M-bar low, with an ATR protective stop.
strategy("Donchian Breakout", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)
entryLen = input.int(55, "Entry channel", minval=2)
exitLen = input.int(20, "Exit channel", minval=2)
atrLen = input.int(20, "ATR length", minval=1)
atrMult = input.float(2.0, "ATR stop", minval=0.1, step=0.1)
hi = ta.highest(high, entryLen)[1]
lo = ta.lowest(low, exitLen)[1]
atr = ta.atr(atrLen)
plot(hi, "Entry level", color=color.teal, style=plot.style_stepline)
plot(lo, "Exit level", color=color.red, style=plot.style_stepline)
if strategy.position_size == 0
    strategy.entry("Long", strategy.long, stop=hi)
if strategy.position_size > 0
    stopPrice = math.max(lo, strategy.position_avg_price - atrMult * atr)
    strategy.exit("Exit", "Long", stop=stopPrice)
